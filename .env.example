# Direcciones del ERP. Las VITE_* terminan dentro del bundle: ninguna es secreta.
VITE_CMS_BASE_URL=https://erp.mashaec.net/api/cms/apustore
VITE_ECOMMERCE_BASE_URL=https://erp.mashaec.net/api/ecommerce/apustore
VITE_ERP_STORAGE_URL=https://erp.mashaec.net/storage
# Token de solo lectura del CMS. El real va en .env.local y en el secreto APUSTORE_CMS_TOKEN.
VITE_CMS_TOKEN=tu-token-del-cms
